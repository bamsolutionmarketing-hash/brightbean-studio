# CORE
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightbean

# STORAGE
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto

# EMAIL
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------
# GOOGLE AUTH — Login / Sign up with Google
# Setup:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
#      (For Vercel: https://yourdomain.vercel.app/accounts/google/login/callback/)
# ---------------------------------------------------------------
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Email verification: "none" (local, login immediately) | "optional" | "mandatory"
ACCOUNT_EMAIL_VERIFICATION=none

# PLATFORM CREDENTIALS (cloud version - self-hosted uses admin UI)
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
# LinkedIn - see README "LinkedIn" section. Choose Path A or Path B (or both).
# Path B (Community Management API) credentials are automatically reused for
# personal connections, giving refresh tokens + inbox.
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
# Legacy shared vars (still honored as fallback for both personal + company,
# assumed to be CM-approved). Leave commented unless migrating from an older install.
# PLATFORM_LINKEDIN_CLIENT_ID=
# PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=


# ---------------------------------------------------------------
# AI CAPTION GENERATION (Antigravity / AI support)
# Gemini is tried first, Claude is the fallback.
# ---------------------------------------------------------------
# Google Gemini -- get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude -- get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# LARK / FEISHU DRIVE SYNC
# ---------------------------------------------------------------
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_WATCH_FOLDER_TOKEN=FolderTokenXXXXXX
LARK_POLL_INTERVAL=300
LARK_USE_FEISHU=false

# ---------------------------------------------------------------
# TELEGRAM CLOUD STORAGE (free, unlimited media archive)
# 1. Create a bot via @BotFather -> get BOT_TOKEN
# 2. Create a private channel, add the bot as admin
# 3. Get channel ID (e.g. -1001234567890) from @userinfobot
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHANNEL_ID=

# ---------------------------------------------------------------
# SUPABASE AUTO-CLEANUP (buffer mode)
# SUPABASE_ROW_LIMIT      -- max ProcessedLarkFile rows before cleanup (default 50000)
# SUPABASE_CLEANUP_THRESHOLD -- fraction that triggers cleanup (default 0.80)
# SUPABASE_CLEANUP_TARGET    -- fraction to reduce down to (default 0.60)
# SUPABASE_QUOTA_BYTES    -- your plan's total storage quota in bytes (default 500 MB)
# SUPABASE_PROJECT_REF    -- project ref for real-time usage API (optional)
# SUPABASE_SERVICE_ROLE_KEY -- service role key for usage API (optional)
# ---------------------------------------------------------------
SUPABASE_ROW_LIMIT=50000
SUPABASE_CLEANUP_THRESHOLD=0.80
SUPABASE_CLEANUP_TARGET=0.60
SUPABASE_QUOTA_BYTES=524288000

# INBOUND WEBHOOKS
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

